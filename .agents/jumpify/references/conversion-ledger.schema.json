{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jumpchain-visualizer.local/jumpify-ledger.schema.json",
  "title": "Jumpify conversion ledger",
  "type": "object",
  "required": [
    "schemaVersion",
    "mode",
    "sourceHash",
    "sourcePages",
    "sections",
    "entries",
    "assets",
    "colorSamples",
    "comparisons",
    "interactionContracts",
    "reviewEvidence",
    "mechanics",
    "gaps",
    "acceptance"
  ],
  "properties": {
    "schemaVersion": { "const": 4 },
    "mode": { "enum": ["semantic", "facsimile"] },
    "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourcePages": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourcePage" }
    },
    "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "colorSamples": {
      "type": "array",
      "items": { "$ref": "#/$defs/colorSample" }
    },
    "comparisons": {
      "type": "array",
      "items": { "$ref": "#/$defs/comparison" }
    },
    "interactionContracts": {
      "type": "array",
      "items": { "$ref": "#/$defs/interactionContract" }
    },
    "reviewEvidence": { "const": "verification/review-evidence.json" },
    "facsimileContracts": { "$ref": "#/$defs/facsimileContracts" },
    "mechanics": { "type": "array", "items": { "$ref": "#/$defs/mechanic" } },
    "gaps": { "type": "array", "items": { "$ref": "#/$defs/gap" } },
    "acceptance": { "type": "array", "items": { "$ref": "#/$defs/acceptance" } }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
    "rect": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "sourcePage": {
      "type": "object",
      "required": [
        "page",
        "width",
        "height",
        "status",
        "entryIds",
        "sectionHandles"
      ],
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["unreviewed", "verified", "uncertain"] },
        "entryIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" }
        },
        "sectionHandles": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" }
        }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": [
        "handle",
        "name",
        "sourcePages",
        "renderIndex",
        "status",
        "surfaceTree"
      ],
      "properties": {
        "handle": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "surfaceTree": { "type": "string", "minLength": 1 },
        "sourcePages": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "renderIndex": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["incomplete", "complete"] }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "page",
        "rect",
        "sourceKind",
        "verification",
        "handles",
        "semantic",
        "presentation",
        "approximation"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "page": { "type": "integer", "minimum": 1 },
        "rect": { "$ref": "#/$defs/rect" },
        "sourceKind": {
          "enum": [
            "prose",
            "choice",
            "artwork",
            "rule",
            "heading",
            "decoration"
          ]
        },
        "transcription": { "type": "string" },
        "verification": {
          "enum": [
            "unreviewed",
            "verified",
            "uncertain",
            "externally-corroborated"
          ]
        },
        "corroboration": { "type": "object" },
        "handles": { "type": "array", "items": { "type": "string" } },
        "semantic": { "type": "object" },
        "presentation": { "type": "object" },
        "approximation": { "type": "string" }
      },
      "additionalProperties": false
    },
    "edgeOwnership": {
      "type": "object",
      "required": ["top", "right", "bottom", "left"],
      "properties": {
        "top": { "type": "string" },
        "right": { "type": "string" },
        "bottom": { "type": "string" },
        "left": { "type": "string" }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "page",
        "rect",
        "output",
        "kind",
        "alt",
        "package",
        "edgeOwnership"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "page": { "type": "integer", "minimum": 1 },
        "rect": { "$ref": "#/$defs/rect" },
        "output": { "type": "string", "pattern": "^[^/].*\\.png$" },
        "kind": { "enum": ["artwork", "panel"] },
        "alt": { "type": "string", "minLength": 1 },
        "package": { "type": "boolean" },
        "edgeOwnership": { "$ref": "#/$defs/edgeOwnership" }
      },
      "additionalProperties": false
    },
    "colorSample": {
      "type": "object",
      "required": ["id", "page", "x", "y"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "page": { "type": "integer", "minimum": 1 },
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "radius": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "required": ["id", "section", "width", "sourcePage", "renderPath"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "section": { "$ref": "#/$defs/identifier" },
        "width": { "enum": [390, 720, 1440] },
        "sourcePage": { "type": "integer", "minimum": 1 },
        "sourceRect": { "$ref": "#/$defs/rect" },
        "renderPath": { "type": "string" }
      },
      "additionalProperties": false
    },
    "interactionState": {
      "type": "object",
      "required": ["name", "evidence", "observation"],
      "properties": {
        "name": {
          "enum": [
            "unset",
            "selected",
            "manual",
            "rolled",
            "changed",
            "limit-disabled",
            "ranked",
            "prose",
            "custom"
          ]
        },
        "evidence": { "type": "string", "pattern": "\\.png$" },
        "note": { "type": "string" },
        "observation": { "$ref": "#/$defs/interactionObservation" }
      },
      "additionalProperties": false
    },
    "screenRect": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 4 },
        "height": { "type": "number", "minimum": 4 }
      },
      "additionalProperties": false
    },
    "interactionObservation": {
      "type": "object",
      "required": [
        "controlKind",
        "controlValue",
        "activationControlKinds",
        "resolutionStatus",
        "resolvedCosts",
        "actionSucceeded",
        "bounds",
        "overlaps"
      ],
      "properties": {
        "controlKind": {
          "enum": [
            "checkbox",
            "radio",
            "text",
            "number",
            "select",
            "companions",
            "none"
          ]
        },
        "controlValue": {
          "type": ["string", "number", "boolean", "array", "null"]
        },
        "activationControlKinds": {
          "type": "array",
          "items": { "enum": ["checkbox", "radio"] }
        },
        "resolutionStatus": {
          "enum": [
            "unset",
            "selected",
            "manual",
            "rolled",
            "changed",
            "limit-disabled",
            "ranked",
            "prose",
            "custom"
          ]
        },
        "resolvedCosts": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "actionSucceeded": { "type": "boolean" },
        "bounds": {
          "type": "object",
          "properties": {
            "surface": { "$ref": "#/$defs/screenRect" },
            "rail": { "$ref": "#/$defs/screenRect" },
            "neighbor": { "$ref": "#/$defs/screenRect" }
          },
          "additionalProperties": false
        },
        "overlaps": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "interactionGeometry": {
      "type": "object",
      "required": ["policy", "evidence", "note"],
      "properties": {
        "policy": { "enum": ["stable", "intentional-source-reflow"] },
        "evidence": { "type": "string", "pattern": "\\.png$" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sourceActivation": {
      "type": "object",
      "required": ["decision", "directInsufficient", "evidence"],
      "properties": {
        "decision": { "type": "string", "minLength": 1 },
        "directInsufficient": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "pattern": "\\.png$" }
      },
      "additionalProperties": false
    },
    "interactionContract": {
      "type": "object",
      "required": [
        "id",
        "entryIds",
        "sourcePage",
        "sourceBehavior",
        "section",
        "owner",
        "placement",
        "selection",
        "resolution",
        "continuity",
        "pricing",
        "states",
        "geometry"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "entryIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "sourcePage": { "type": "integer", "minimum": 1 },
        "sourceBehavior": { "type": "string", "minLength": 1 },
        "section": { "$ref": "#/$defs/identifier" },
        "owner": { "enum": ["choice", "choice-source", "prose"] },
        "handle": { "$ref": "#/$defs/identifier" },
        "placement": { "enum": ["direct", "source", "none"] },
        "sourceHandle": { "$ref": "#/$defs/identifier" },
        "sourceActivation": { "$ref": "#/$defs/sourceActivation" },
        "selection": {
          "enum": [
            "toggle",
            "text",
            "integer",
            "select",
            "companions",
            "source-members",
            "none"
          ]
        },
        "resolution": { "enum": ["manual", "random", "either", "none"] },
        "continuity": { "enum": ["previous", "original", "none"] },
        "pricing": {
          "enum": ["ordinary", "rolled-free", "continuity-change", "none"]
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/interactionState" }
        },
        "geometry": { "$ref": "#/$defs/interactionGeometry" }
      },
      "additionalProperties": false
    },
    "facsimileContracts": {
      "type": "object",
      "required": [
        "semanticNames",
        "choiceGrantSemantics",
        "referentResolutions",
        "grantInventory",
        "dynamicEntities",
        "tagPlacements",
        "alignmentRelationships",
        "independentReview"
      ],
      "properties": {
        "semanticNames": {
          "type": "array",
          "items": { "$ref": "#/$defs/facsimileSemanticName" }
        },
        "choiceGrantSemantics": {
          "type": "array",
          "items": { "$ref": "#/$defs/facsimileChoiceGrantSemantic" }
        },
        "referentResolutions": {
          "type": "array",
          "items": { "$ref": "#/$defs/facsimileReferentResolution" }
        },
        "grantInventory": { "$ref": "#/$defs/facsimileGrantInventory" },
        "dynamicEntities": {
          "type": "array",
          "items": { "$ref": "#/$defs/facsimileDynamicEntity" }
        },
        "tagPlacements": {
          "type": "array",
          "items": { "$ref": "#/$defs/facsimileTagPlacement" }
        },
        "tagCardinalityReview": {
          "$ref": "#/$defs/facsimileTagCardinalityReview"
        },
        "alignmentRelationships": {
          "type": "array",
          "items": { "$ref": "#/$defs/facsimileAlignmentRelationship" }
        },
        "independentReview": { "$ref": "#/$defs/facsimileIndependentReview" }
      },
      "additionalProperties": false
    },
    "facsimileSemanticName": {
      "type": "object",
      "required": [
        "handle",
        "sourceEntry",
        "sourceText",
        "semanticName",
        "sourceEffectText",
        "liveDescription"
      ],
      "properties": {
        "handle": { "$ref": "#/$defs/identifier" },
        "sourceEntry": { "$ref": "#/$defs/identifier" },
        "sourceText": { "type": "string", "minLength": 1 },
        "semanticName": { "type": "string", "minLength": 1 },
        "sourceEffectText": { "type": "string", "minLength": 1 },
        "liveDescription": { "type": "string", "minLength": 1 },
        "panelStrategy": {
          "enum": ["intact", "measured-fragments"],
          "default": "intact"
        },
        "sourcePanelAssets": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "decompositionReason": { "type": "string", "minLength": 1 },
        "intentionalAllCaps": { "type": "boolean", "default": false },
        "normalizationNote": { "type": "string", "minLength": 1 },
        "developerAuthorization": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "facsimileGrantInventory": {
      "type": "object",
      "required": [
        "entryDecisions",
        "sourceEntryIds",
        "status",
        "note",
        "grants"
      ],
      "properties": {
        "entryDecisions": {
          "type": "array",
          "items": { "$ref": "#/$defs/facsimileGrantEntryDecision" }
        },
        "sourceEntryIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" }
        },
        "status": { "enum": ["unreviewed", "complete"] },
        "note": { "type": "string", "minLength": 1 },
        "grants": {
          "type": "array",
          "items": { "$ref": "#/$defs/facsimileJumpGrant" }
        }
      },
      "additionalProperties": false
    },
    "facsimileGrantEntryDecision": {
      "type": "object",
      "required": ["entryId", "clauses"],
      "properties": {
        "entryId": { "$ref": "#/$defs/identifier" },
        "clauses": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/facsimileGrantClauseDecision" }
        }
      },
      "additionalProperties": false
    },
    "facsimileGrantClauseDecision": {
      "type": "object",
      "required": ["dispositions", "semanticForce", "sourceEvidence", "reason"],
      "properties": {
        "dispositions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "jump-grant",
              "choice-grant",
              "shared-choice-grant",
              "no-grant"
            ]
          }
        },
        "semanticForce": {
          "enum": [
            "explicit-grant",
            "retained-existing",
            "narrative",
            "current-jump-rule",
            "conditional-choice-effect",
            "mechanical-instruction",
            "presentation"
          ]
        },
        "sourceEvidence": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "grantKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(perk|item|form|companion|trait):.+$"
          }
        },
        "sharedEffectText": { "type": "string", "minLength": 1 },
        "targetHandles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "dispositions": { "contains": { "const": "jump-grant" } }
            },
            "required": ["dispositions"]
          },
          "then": {
            "required": ["grantKeys"],
            "properties": {
              "semanticForce": {
                "enum": ["explicit-grant", "current-jump-rule"]
              }
            }
          }
        },
        {
          "if": {
            "required": ["grantKeys"]
          },
          "then": {
            "properties": {
              "dispositions": { "contains": { "const": "jump-grant" } }
            }
          }
        },
        {
          "if": {
            "properties": {
              "dispositions": {
                "contains": { "const": "shared-choice-grant" }
              }
            },
            "required": ["dispositions"]
          },
          "then": { "required": ["sharedEffectText", "targetHandles"] }
        },
        {
          "if": {
            "properties": {
              "dispositions": { "contains": { "const": "no-grant" } }
            },
            "required": ["dispositions"]
          },
          "then": { "properties": { "dispositions": { "maxItems": 1 } } }
        }
      ],
      "additionalProperties": false
    },
    "facsimileJumpGrant": {
      "type": "object",
      "required": [
        "entryId",
        "kind",
        "name",
        "description",
        "tags",
        "tagRationale"
      ],
      "properties": {
        "entryId": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["perk", "item", "form", "companion", "trait"] },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "canonicalGrantRef": {
          "type": "string",
          "pattern": "^jump:[0-9]+:(companion|form):.+$"
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "tagRationale": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": { "enum": ["companion", "form"] }
            },
            "required": ["kind"]
          },
          "then": { "required": ["canonicalGrantRef"] }
        }
      ],
      "additionalProperties": false
    },
    "facsimileChoiceGrantSemantic": {
      "type": "object",
      "required": [
        "choiceHandle",
        "grantIndex",
        "sourceEntry",
        "effectRole",
        "sourceEvidence",
        "reason"
      ],
      "properties": {
        "choiceHandle": { "$ref": "#/$defs/identifier" },
        "grantIndex": { "type": "integer", "minimum": 0 },
        "sourceEntry": { "$ref": "#/$defs/identifier" },
        "effectRole": {
          "enum": [
            "entity-acquisition",
            "entity-classification",
            "entity-enhancement",
            "ability",
            "possession",
            "form",
            "current-jump-circumstance",
            "identity-property",
            "resource-change"
          ]
        },
        "sourceEvidence": { "type": "string", "minLength": 1 },
        "subjectGrantHandle": { "$ref": "#/$defs/identifier" },
        "projection": {
          "enum": ["entity-name", "tracker-description", "property-only"]
        },
        "tagRationale": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "facsimileReferentResolution": {
      "type": "object",
      "required": ["sourceEntry", "sourceEvidence", "resolution", "reason"],
      "properties": {
        "sourceEntry": { "$ref": "#/$defs/identifier" },
        "sourceEvidence": { "type": "string", "minLength": 1 },
        "resolution": {
          "enum": ["same-entity", "new-entity", "narrative-only"]
        },
        "targetChoiceHandle": { "$ref": "#/$defs/identifier" },
        "targetGrantHandle": { "$ref": "#/$defs/identifier" },
        "targetJumpGrantRef": { "type": "string", "minLength": 1 },
        "distinctnessEvidence": { "type": "string", "minLength": 1 },
        "distinctnessBasis": {
          "enum": [
            "explicit-additionality",
            "independent-slot-or-count",
            "simultaneous-possession",
            "incompatible-source-identity"
          ]
        },
        "comparedDynamicEntityRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*:[a-z][a-z0-9_]*$"
          }
        },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resolution": { "enum": ["same-entity", "new-entity"] }
            },
            "required": ["resolution"]
          },
          "then": {
            "oneOf": [
              {
                "required": ["targetChoiceHandle", "targetGrantHandle"],
                "not": { "required": ["targetJumpGrantRef"] }
              },
              {
                "required": ["targetJumpGrantRef"],
                "not": {
                  "anyOf": [
                    { "required": ["targetChoiceHandle"] },
                    { "required": ["targetGrantHandle"] }
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": { "resolution": { "const": "new-entity" } },
            "required": ["resolution"]
          },
          "then": {
            "required": [
              "distinctnessEvidence",
              "distinctnessBasis",
              "comparedDynamicEntityRefs"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "facsimileDynamicEntity": {
      "type": "object",
      "required": [
        "choiceHandle",
        "kind",
        "grantHandle",
        "visibleNameTemplate",
        "contextLabel",
        "classificationChoiceHandles",
        "upgradeHandles",
        "creationEvidence",
        "trackerEvidence"
      ],
      "properties": {
        "choiceHandle": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["companion", "form"] },
        "grantHandle": { "$ref": "#/$defs/identifier" },
        "visibleNameTemplate": { "type": "string", "minLength": 1 },
        "contextLabel": { "type": "string", "minLength": 1 },
        "classificationChoiceHandles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "classificationSourceHandle": { "$ref": "#/$defs/identifier" },
        "classificationPropertyHandle": { "$ref": "#/$defs/identifier" },
        "upgradeHandles": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" }
        },
        "creationEvidence": { "type": "string", "minLength": 1 },
        "trackerEvidence": { "type": "string", "minLength": 1 },
        "continuityEvidence": { "type": "string", "minLength": 1 },
        "upgradeEvidence": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classificationChoiceHandles": { "minItems": 1 }
            },
            "required": ["classificationChoiceHandles"]
          },
          "then": {
            "required": [
              "classificationSourceHandle",
              "classificationPropertyHandle"
            ]
          }
        },
        {
          "if": {
            "properties": { "upgradeHandles": { "minItems": 1 } },
            "required": ["upgradeHandles"]
          },
          "then": { "required": ["upgradeEvidence"] }
        }
      ],
      "additionalProperties": false
    },
    "facsimileTagPlacement": {
      "type": "object",
      "required": ["choiceHandle", "decision", "tags"],
      "properties": {
        "choiceHandle": { "$ref": "#/$defs/identifier" },
        "decision": { "enum": ["placed", "not-applicable"] },
        "tags": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "layoutHandle": { "$ref": "#/$defs/identifier" },
        "railOrder": {
          "type": "array",
          "items": { "enum": ["control", "tags", "cost", "roll"] }
        },
        "reason": { "type": "string" },
        "tagRationale": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "decision": { "const": "placed" } } },
          "then": {
            "required": ["layoutHandle", "railOrder", "tagRationale"],
            "properties": { "tags": { "minItems": 1 } }
          },
          "else": { "required": ["reason"] }
        }
      ],
      "additionalProperties": false
    },
    "facsimileTagCardinalityReview": {
      "type": "object",
      "required": ["status", "choiceHandles", "grantRefs", "reason"],
      "properties": {
        "status": { "const": "justified" },
        "choiceHandles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "grantRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(jump|choice:[a-z][a-z0-9_]*):[0-9]+:(perk|item|form|companion|trait):.+$"
          }
        },
        "reason": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "properties": { "choiceHandles": { "minItems": 1 } } },
        { "properties": { "grantRefs": { "minItems": 1 } } }
      ],
      "additionalProperties": false
    },
    "facsimileAlignmentRelationship": {
      "type": "object",
      "required": [
        "id",
        "entryIds",
        "sourceRelation",
        "relation",
        "width",
        "sourceBounds",
        "renderBounds",
        "status",
        "evidence"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "entryIds": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "sourceRelation": { "type": "string", "minLength": 1 },
        "relation": {
          "enum": [
            "same-row",
            "same-column",
            "left-edge",
            "right-edge",
            "top-edge",
            "bottom-edge",
            "center-x",
            "center-y",
            "equal-width",
            "equal-height"
          ]
        },
        "width": { "const": 1440 },
        "sourceBounds": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/rect" }
        },
        "renderBounds": {
          "type": "array",
          "items": { "$ref": "#/$defs/screenRect" }
        },
        "sourceTolerance": {
          "type": "number",
          "minimum": 0,
          "maximum": 64,
          "default": 8
        },
        "renderTolerance": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "default": 2
        },
        "status": { "type": "string", "pattern": "^(pass|unreviewed|gap:.+)$" },
        "evidence": { "type": "string" }
      },
      "additionalProperties": false
    },
    "facsimileIndependentReview": {
      "type": "object",
      "required": ["reviewer", "status", "evidence", "findings"],
      "properties": {
        "reviewer": { "enum": ["clean-context-agent", "independent-human"] },
        "status": { "enum": ["unreviewed", "pass", "fail"] },
        "evidence": { "type": "string" },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/facsimileReviewFinding" }
        },
        "entityContinuityReviews": {
          "type": "array",
          "items": { "$ref": "#/$defs/facsimileEntityContinuityReview" }
        }
      },
      "additionalProperties": false
    },
    "facsimileEntityContinuityReview": {
      "type": "object",
      "required": ["sourceEntry", "targetRef", "status", "reason", "evidence"],
      "properties": {
        "sourceEntry": { "$ref": "#/$defs/identifier" },
        "targetRef": {
          "type": "string",
          "pattern": "^(choice:[a-z][a-z0-9_]*:[a-z][a-z0-9_]*|jump:[0-9]+:(companion|form):.+)$"
        },
        "status": { "enum": ["supported", "unsupported"] },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "facsimileReviewFinding": {
      "type": "object",
      "required": ["id", "description", "status", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "resolved", "gap"] },
        "evidence": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "mechanic": {
      "type": "object",
      "required": ["id", "description", "status", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "pattern": "^(pass|unreviewed|gap:.+)$" },
        "evidence": { "type": "string" }
      },
      "additionalProperties": false
    },
    "gap": {
      "type": "object",
      "required": [
        "id",
        "requirement",
        "experiment",
        "evidence",
        "limitation",
        "fidelityLoss",
        "approximation"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "requirement": { "type": "string" },
        "experiment": { "type": "string" },
        "evidence": { "type": "string" },
        "limitation": { "type": "string" },
        "fidelityLoss": { "type": "string" },
        "approximation": { "type": "string" }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "object",
      "required": ["section", "width", "check", "status", "evidence"],
      "properties": {
        "section": { "$ref": "#/$defs/identifier" },
        "width": { "enum": [390, 720, 1440] },
        "check": {
          "enum": [
            "structure-and-surfaces",
            "text",
            "artwork-and-crops",
            "costs-and-controls",
            "content-and-semantics",
            "responsive-fit"
          ]
        },
        "status": {
          "type": "string",
          "pattern": "^(pass|fail|unreviewed|gap:.+)$"
        },
        "evidence": { "type": "string" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
