{
  "name": "jumpchain-visualizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "corepack pnpm typecheck && vite build",
    "build:client": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run --project unit",
    "test:verification": "node --test scripts/*.test.mjs",
    "test:browser": "vitest run --project browser --browser.headless",
    "test:e2e": "node scripts/run-playwright.mjs chromium",
    "test:e2e:smoke": "node scripts/run-playwright.mjs smoke",
    "test:e2e:chromium": "node scripts/run-playwright.mjs chromium",
    "test:e2e:cross-browser": "node scripts/run-playwright.mjs cross-browser",
    "test:e2e:exhaustive": "node scripts/run-playwright.mjs exhaustive",
    "test:e2e:artifacts": "node scripts/run-playwright.mjs artifacts",
    "test:e2e:report": "playwright show-report",
    "test:native": "corepack pnpm tauri build --debug --no-bundle && wdio run wdio.conf.ts",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/.eslintcache --cache-strategy content .",
    "format": "prettier --write .",
    "format:check": "prettier --cache --cache-strategy content --check .",
    "generate:markup": "lezer-generator src/markup/format1.grammar -o src/markup/format1Parser.generated.ts",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets --all-features -- -D warnings && cargo test --workspace --all-features",
    "rust:cache:status": "node scripts/rust-cache.mjs",
    "rust:cache:clean": "cargo clean",
    "check:core": "node scripts/verify.mjs core",
    "check": "node scripts/verify.mjs fast",
    "check:full": "node scripts/verify.mjs full",
    "check:exhaustive": "node scripts/verify.mjs exhaustive",
    "check:release": "node scripts/verify.mjs release",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.12.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@lezer/common": "1.5.2",
    "@lezer/generator": "1.8.0",
    "@lezer/highlight": "1.2.3",
    "@lezer/lr": "1.4.8",
    "@tauri-apps/api": "2.11.1",
    "fflate": "^0.8.3",
    "i18next": "^26.3.6",
    "konva": "10.3.0",
    "nspell": "^2.1.5",
    "pica": "10.0.2",
    "react": "19.2.7",
    "react-aria-components": "1.19.0",
    "react-dom": "19.2.7",
    "react-i18next": "^17.0.10",
    "react-konva": "19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.10.1",
    "@types/nspell": "^2.1.6",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@wdio/cli": "9.29.1",
    "@wdio/local-runner": "9.29.1",
    "@wdio/mocha-framework": "9.29.1",
    "@wdio/spec-reporter": "9.29.1",
    "@wdio/tauri-service": "1.2.0",
    "@wdio/types": "9.29.1",
    "dictionary-en": "^4.0.0",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "vitest-browser-react": "2.2.0",
    "webdriverio": "9.29.1"
  }
}
