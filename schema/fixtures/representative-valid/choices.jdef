choice
  handle: flight
  name: "Flight"
  group: perks
  tag: movement
  selection: integer
  min: 0
  max: 3
  resolution: either

  text
    handle: description
    content:
      """
      Move freely through the air.
      """
    content when flight >= 2: "Flight rank {{flight}} with call sign {{call_sign}}."

  input
    handle: call_sign
    selection: text
    placeholder: "Optional call sign"

  cost
    resource: jump_points
    amount: 100
    mode: each

  cost
    resource: mana
    amount: small

  grant
    kind: resource
    resource: mana
    amount: 5

  grant: perk
