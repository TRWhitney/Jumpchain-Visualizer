jump-appearance
  background: white
  text-color: "#112233"
  accent-color: purple
  corners: md

section-layout
  handle: choice_section

  grid
    columns: 2
    gap: md
    padding: sm
    slot: name
    text: description
    rule
      color: purple
      thickness: 2
      style: rounded
    choice: gender_field
    choice
      target: age_field
      align: end

    expand
      source: main
      using: choice_card

choice-layout
  handle: choice_card

  stack
    gap: sm
    padding: xs

    inline
      justify: between
      slot: name
      slot: cost

    text: description
    slot: control
    slot: roll
    slot: tags
