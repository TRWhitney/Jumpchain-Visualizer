section-layout
  handle: choice_section

  grid
    columns: 2
    gap: md
    padding: sm
    slot: name
    text: description
    rule
      color: purple
      thickness: 2
      style: dash
    choice: gender_field
    choice: age_field

    expand
      source: main
      using: choice_card

choice-layout
  handle: choice_card

  stack
    gap: sm
    padding: xs

    inline
      justify: between
      slot: name
      slot: cost

    text: description
    slot: control
    slot: roll
    slot: tags
