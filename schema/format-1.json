{
  "schemaVersion": 1,
  "format": 1,
  "name": "Jumpchain definition format 1",
  "source": "../documentation/development/markup.html",
  "lexical": {
    "encoding": "UTF-8",
    "lineEnding": "LF",
    "indent": "two spaces",
    "tabs": "error",
    "comment": "full-line # comments only",
    "handlePattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$",
    "integerPattern": "^-?(?:0|[1-9][0-9]*)$",
    "hexColorPattern": "^#[0-9A-Fa-f]{6}$",
    "assetPathSeparator": "/",
    "fieldLine": "one field per physical line; an unquoted second field delimiter is an error",
    "fieldOrder": "insignificant except conditional variants and source-ordered collections",
    "duplicateScalarField": "error"
  },
  "files": {
    "jump.jdef": {
      "required": true,
      "topLevel": ["jump", "jump-appearance", "resource", "section", "choice", "theme", "section-layout", "choice-layout", "trait-layout"],
      "counts": { "jump": { "min": 1, "max": 1 }, "section": { "min": 1 } }
    },
    "choices.jdef": {
      "required": false,
      "topLevel": ["choice"]
    },
    "layout.jdef": {
      "required": false,
      "topLevel": ["jump-appearance", "theme", "section-layout", "choice-layout", "trait-layout"],
      "counts": { "jump-appearance": { "max": 1 } }
    }
  },
  "types": {
    "quotedString": { "syntax": "double quoted", "placeholders": true },
    "renderableScalar": { "syntax": "double quoted", "placeholders": true, "conditionalVariants": true },
    "richText": {
      "syntax": "triple-quoted fenced body",
      "placeholders": true,
      "formatting": ["paragraph", "bold", "italic", "strikethrough", "underline", "unordered-list", "table"],
      "forbiddenFormatting": ["raw-html", "link", "autolink", "task-checkbox", "heading", "blockquote", "code"]
    },
    "handle": { "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
    "handleReference": { "type": "handle", "forwardReferences": true },
    "integer": { "pattern": "^-?(?:0|[1-9][0-9]*)$" },
    "boolean": { "enum": [true, false] },
    "tag": { "syntax": ["bare", "quoted"], "canonicalization": "NFKC, case fold, whitespace/underscore/dash runs to one ASCII space, trim" },
    "color": {
      "oneOf": ["hexColor", "colorToken"],
      "builtInTokens": ["black", "white", "gray", "red", "orange", "yellow", "green", "blue", "purple", "brown", "pink"]
    },
    "spacing": { "enum": ["none", "xs", "sm", "md", "lg", "xl", "2xl"] },
    "size": { "enum": ["xs", "sm", "md", "lg", "xl", "2xl", "3xl", "4xl"] },
    "textSize": {
      "enum": ["xs", "sm", "md", "lg", "xl", "2xl", "3xl", "4xl"],
      "syntax": "a named text-size token, 8px through 512px, or .5rem through 32rem"
    },
    "layoutDimension": {
      "enum": ["xs", "sm", "md", "lg", "xl", "2xl"],
      "syntax": "a named size token, a bounded pixel length, or a bounded rem length"
    },
    "aspectRatio": { "syntax": "two positive integers separated by /" },
    "fontFamily": { "enum": ["system", "sans", "serif", "monospace", "condensed"] },
    "fontWeight": { "enum": ["light", "normal", "semibold", "bold", "black"] },
    "lineHeight": { "enum": ["solid", "tight", "normal", "relaxed"] },
    "letterSpacing": { "enum": ["tight", "normal", "wide", "widest"] },
    "listMarker": { "enum": ["application", "disc", "dash", "none"] },
    "density": { "enum": ["standard", "compact"] },
    "imageDimension": {
      "enum": ["xs", "sm", "md", "lg", "xl", "2xl"],
      "syntax": "a named size token, a non-negative pixel length, or a non-negative rem length"
    },
    "imageFit": { "enum": ["contain", "cover", "tile"] },
    "align": { "enum": ["start", "center", "end", "stretch"] },
    "justify": { "enum": ["start", "center", "end", "between"] },
    "textAlign": { "enum": ["start", "center", "end", "justify"] },
    "costAmount": {
      "oneOf": ["integer", "costToken", "awardToken"],
      "costTokens": ["trivial", "small", "medium", "large", "major", "extreme"],
      "awardTokens": ["add_trivial", "add_small", "add_medium", "add_large", "add_major", "add_extreme"]
    },
    "grantAmount": {
      "oneOf": ["integer", "grantToken"],
      "grantTokens": ["trivial", "small", "medium", "large", "major", "extreme"]
    },
    "propertyValue": { "oneOf": ["quotedString", "integer", "boolean"] }
  },
  "conditionalFields": {
    "allowed": ["name", "alt", "content", "option"],
    "syntax": "<field> when <expression>:",
    "baseFallback": true,
    "matching": "first matching variant in source order; base only when none match",
    "repeatedFieldAssociation": "An option variant belongs to the immediately preceding base option at the same owner and indentation. A different base option starts a new variant group.",
    "expression": {
      "operators": ["!", "=", "!=", "<", "<=", ">", ">=", "and", "or"],
      "precedence": ["parentheses", "!", "comparisons", "and", "or"],
      "propertyTypes": ["boolean", "integer", "string"],
      "orderingTypes": ["integer"],
      "contextProperties": {
        "rank": "integer choice or input with a rank-measured visible grant",
        "count": "integer choice or input with a quantity-measured visible grant",
        "choiceAndInputAnswers": "Text owned by a choice may use that scalar choice handle and its owner-local scalar input handles"
      },
      "functionCalls": false,
      "arithmetic": false,
      "coercion": false
    }
  },
  "declarations": {
    "jump": {
      "contexts": ["top-level"],
      "fields": {
        "format": { "type": "integer", "min": 1, "max": 1, "required": true, "const": 1 },
        "name": { "type": "renderableScalar", "min": 1, "max": 1, "required": true },
        "description": { "type": "quotedString", "min": 0, "max": 1 },
        "author": { "type": "quotedString", "min": 1, "repeatable": true, "setLike": true },
        "version": { "type": "quotedString", "min": 1, "max": 1, "required": true },
        "gauntlet": { "type": "boolean", "min": 0, "max": 1, "default": false },
        "starting-points": { "type": "integer", "min": 0, "max": 1, "default": 1000 },
        "points-name": { "type": "renderableScalar", "min": 0, "max": 1, "default": "Choice Points" },
        "points-abbreviation": { "type": "renderableScalar", "min": 0, "max": 1, "default": "CP" },
        "discount-stacking": { "type": "enum", "values": ["highest", "stack"], "min": 0, "max": 1, "default": "highest" },
        "discount-floor": { "type": "enum", "values": ["zero", "negative"], "min": 0, "max": 1, "default": "zero" },
        "section-layout": { "type": "handleReference:section-layout", "min": 0, "max": 1 },
        "choice-layout": { "type": "handleReference:choice-layout", "min": 0, "max": 1 },
        "trait-layout": { "type": "handleReference:trait-layout", "min": 0, "max": 1 }
      },
      "children": {
        "grant": { "min": 0, "repeatable": true, "ordered": true }
      }
    },
    "resource": {
      "contexts": ["top-level"],
      "fields": {
        "handle": { "type": "handle", "min": 1, "max": 1, "required": true, "reserved": ["jump_points"] },
        "name": { "type": "renderableScalar", "min": 1, "max": 1, "required": true },
        "abbreviation": { "type": "renderableScalar", "min": 0, "max": 1 },
        "initial": { "type": "integer", "min": 0, "max": 1, "default": 0 }
      },
      "children": {}
    },
    "section": {
      "contexts": ["top-level"],
      "fields": {
        "handle": { "type": "handle", "min": 1, "max": 1, "required": true },
        "name": { "type": "renderableScalar", "min": 1, "max": 1, "required": true },
        "layout": { "type": "handleReference:section-layout", "min": 0, "max": 1 },
        "locked": { "type": "integer", "min": 0, "max": 1, "minimum": 0, "maximum": 5, "default": 0 }
      },
      "children": {
        "choice-source": { "min": 0, "repeatable": true, "ordered": true },
        "choice": { "min": 0, "repeatable": true, "ordered": true, "ownerLocalHandleNamespace": "choice-placement" },
        "text": { "min": 0, "repeatable": true, "ownerLocalHandleNamespace": "text" },
        "image": { "min": 0, "repeatable": true, "ownerLocalHandleNamespace": "image" }
      }
    },
    "choice-source": {
      "contexts": ["section"],
      "fields": {
        "handle": { "type": "handle", "min": 1, "max": 1, "required": true },
        "group": { "type": "tag", "min": 0, "max": 1 },
        "mode": { "type": "enum", "values": ["single", "multi"], "min": 0, "max": 1, "default": "multi" },
        "max": { "type": "integer", "min": 0, "max": 1, "minimum": 1, "appliesWhen": { "mode": ["multi"] } },
        "resolution": { "type": "enum", "values": ["random", "either"], "min": 0, "max": 1, "default": "manual" }
      },
      "children": {}
    },
    "choice": {
      "contexts": ["top-level", "section"],
      "formsByContext": {
        "top-level": {
          "fields": {
            "handle": { "type": "handle", "min": 1, "max": 1, "required": true },
            "name": { "type": "renderableScalar", "min": 1, "max": 1, "required": true },
            "layout": { "type": "handleReference:choice-layout", "min": 0, "max": 1 },
            "tag": { "type": "tag", "min": 0, "repeatable": true, "setLike": true },
            "group": { "type": "tag", "min": 0, "repeatable": true, "setLike": true },
            "selection": { "type": "enum", "values": ["toggle", "text", "integer", "select", "companions"], "min": 0, "max": 1, "default": "toggle" },
            "placeholder": { "type": "quotedString", "min": 0, "max": 1, "appliesWhen": { "selection": ["text", "integer", "select", "companions"] } },
            "continuity": { "type": "enum", "values": ["previous", "original"], "min": 0, "max": 1, "appliesWhen": { "selection": ["select"] } },
            "min": { "type": "integer", "min": 0, "max": 1, "appliesWhen": { "selection": ["integer", "companions"] } },
            "max": { "type": "integer", "min": 0, "max": 1, "defaultForCompanionSelection": 1, "appliesWhen": { "selection": ["integer", "companions"] } },
            "resolution": { "type": "enum", "values": ["random", "either"], "min": 0, "max": 1, "default": "manual", "appliesWhen": { "selection": ["integer", "select"] } },
            "option": { "type": "renderableScalar", "min": 0, "repeatable": true, "ordered": true, "exactDuplicate": "error", "appliesWhen": { "selection": ["select"] } },
            "form": { "type": "handleReference:form", "min": 0, "max": 1, "shorthandTarget": "single scalar perk grant" },
            "companion": { "type": "handleReference:companionTarget", "min": 0, "max": 1, "shorthandTarget": "single scalar perk grant" },
            "measure": { "type": "enum", "values": ["rank", "quantity"], "min": 0, "max": 1, "defaultForIntegerVisibleGrant": "rank", "shorthandTarget": "single scalar perk or item grant" },
            "lock": { "type": "handleReference:section", "min": 0, "repeatable": true, "setLike": true },
            "unlock": { "type": "handleReference:section", "min": 0, "repeatable": true, "setLike": true }
          },
          "children": {
            "text": { "min": 0, "repeatable": true, "ownerLocalHandleNamespace": "text" },
            "image": { "min": 0, "repeatable": true, "ownerLocalHandleNamespace": "image" },
            "input": { "min": 0, "repeatable": true, "ownerLocalHandleNamespace": "input" },
            "cost": { "min": 0, "repeatable": true, "uniqueBy": "resolved resource" },
            "grant": { "min": 0, "repeatable": true, "ordered": true },
            "discount": { "min": 0, "repeatable": true, "ordered": true }
          }
        },
        "section": {
          "fields": {
            "handle": { "type": "handle", "min": 1, "max": 1, "required": true },
            "target": { "type": "handleReference:choice", "min": 1, "max": 1, "required": true }
          },
          "children": {}
        }
      }
    },
    "text": {
      "contexts": ["section", "choice", "grant:perk", "grant:item", "grant:form", "grant:companion", "grant:trait"],
      "fields": {
        "handle": { "type": "handle", "min": 1, "max": 1, "required": true },
        "content": { "type": "richText", "min": 0, "max": 1, "conditionalVariants": true }
      },
      "formsByContext": {
        "grant:perk": { "fields": { "handle": { "type": "handle", "min": 1, "max": 1, "required": true, "const": "description" } } },
        "grant:item": { "fields": { "handle": { "type": "handle", "min": 1, "max": 1, "required": true, "const": "description" } } },
        "grant:form": { "fields": { "handle": { "type": "handle", "min": 1, "max": 1, "required": true, "const": "description" } } },
        "grant:companion": { "fields": { "handle": { "type": "handle", "min": 1, "max": 1, "required": true, "const": "description" } } }
      },
      "children": {},
      "empty": "warning"
    },
    "image": {
      "contexts": ["section", "choice", "grant:trait"],
      "fields": {
        "handle": { "type": "handle", "min": 1, "max": 1, "required": true },
        "src": { "type": "quotedString:assetRelativePath", "min": 0, "max": 1, "exportRequired": true },
        "alt": { "type": "renderableScalar", "min": 0, "max": 1, "conditionalVariants": true, "omission": "accessibility warning" },
        "rounded-corners": { "type": "boolean", "min": 0, "max": 1, "default": false },
        "fade-edges": { "type": "boolean", "min": 0, "max": 1, "default": false },
        "rounded-intensity": { "type": "integer", "min": 0, "max": 1, "minimum": 1, "maximum": 100, "default": 25, "appliesWhen": { "rounded-corners": ["true"] } },
        "fade-intensity": { "type": "integer", "min": 0, "max": 1, "minimum": 1, "maximum": 100, "default": 25, "appliesWhen": { "fade-edges": ["true"] } }
      },
      "children": {}
    },
    "input": {
      "contexts": ["choice"],
      "fields": {
        "handle": { "type": "handle", "min": 1, "max": 1, "required": true },
        "selection": { "type": "enum", "values": ["text", "integer", "select"], "min": 1, "max": 1, "required": true },
        "placeholder": { "type": "quotedString", "min": 0, "max": 1 },
        "min": { "type": "integer", "min": 0, "max": 1, "appliesWhen": { "selection": ["integer"] } },
        "max": { "type": "integer", "min": 0, "max": 1, "appliesWhen": { "selection": ["integer"] } },
        "option": { "type": "renderableScalar", "min": 0, "repeatable": true, "ordered": true, "exactDuplicate": "error", "appliesWhen": { "selection": ["select"] } }
      },
      "children": {
        "grant": { "min": 0, "repeatable": true, "ordered": true }
      }
    },
    "cost": {
      "contexts": ["choice"],
      "forms": {
        "scalar": { "type": "costAmount", "resource": "jump_points", "mode": "flat" },
        "block": {
          "fields": {
            "resource": { "type": "handleReference:resource", "min": 1, "max": 1, "required": true },
            "amount": { "type": "costAmount", "min": 1, "max": 1, "required": true },
            "mode": { "type": "enum", "values": ["flat", "each"], "min": 0, "max": 1, "default": "flat" }
          }
        }
      }
    },
    "discount": {
      "contexts": ["choice"],
      "fields": {
        "group": { "type": "tag", "min": 1, "max": 1, "required": true },
        "mode": { "type": "enum", "values": ["flat", "percent"], "min": 1, "max": 1, "required": true },
        "amount": { "type": "integer", "min": 1, "max": 1, "required": true, "minimum": 0 },
        "resource": { "type": "handleReference:resource", "min": 0, "repeatable": true, "setLike": true }
      },
      "children": {}
    },
    "grant": {
      "contexts": ["jump", "choice", "input"],
      "forms": {
        "scalar": { "type": "enum", "values": ["perk", "item", "companion"] },
        "block": {
          "fields": {
            "kind": { "type": "enum", "values": ["perk", "item", "form", "companion", "resource", "trait", "property"], "min": 1, "max": 1, "required": true },
            "name": { "type": "renderableScalar", "min": 0, "max": 1, "appliesWhen": { "kind": ["perk", "item", "form", "companion", "trait"] } },
            "layout": { "type": "handleReference:trait-layout", "min": 0, "max": 1, "appliesWhen": { "kind": ["trait"] } },
            "tag": { "type": "tag", "min": 0, "repeatable": true, "setLike": true, "appliesWhen": { "kind": ["perk", "item", "form", "companion", "trait"] } },
            "resource": { "type": "handleReference:resource", "min": 0, "max": 1, "appliesWhen": { "kind": ["resource"] } },
            "amount": { "type": "grantAmount", "min": 0, "max": 1, "appliesWhen": { "kind": ["resource"] } },
            "handle": { "type": "handle", "min": 0, "max": 1, "appliesWhen": { "kind": ["form", "companion", "property"] } },
            "form": { "type": "handleReference:form", "min": 0, "max": 1, "appliesWhen": { "kind": ["perk"] } },
            "companion": { "type": "handleReference:companionTarget", "min": 0, "max": 1, "appliesWhen": { "kind": ["perk", "resource"] } },
            "measure": { "type": "enum", "values": ["rank", "quantity"], "min": 0, "max": 1, "defaultForIntegerVisibleGrant": "rank", "appliesWhen": { "kind": ["perk", "item", "trait"] } },
            "value": { "type": "propertyValue", "min": 0, "max": 1, "appliesWhen": { "kind": ["property"] } }
          },
          "children": {
            "text": { "min": 0, "repeatable": true, "ownerLocalHandleNamespace": "text", "appliesWhen": { "kind": ["perk", "item", "form", "companion", "trait"] } },
            "image": { "min": 0, "repeatable": true, "ownerLocalHandleNamespace": "image", "appliesWhen": { "kind": ["trait"] } }
          }
        }
      }
    },
    "theme": {
      "contexts": ["top-level"],
      "fields": {
        "handle": { "type": "handle", "min": 1, "max": 1, "required": true },
        "color": { "type": "hexColor", "min": 1, "max": 1, "required": true }
      },
      "children": {}
    },
    "jump-appearance": {
      "contexts": ["top-level"],
      "fields": {
        "background": { "type": "color", "min": 0, "max": 1 },
        "text-color": { "type": "color", "min": 0, "max": 1 },
        "border-color": { "type": "color", "min": 0, "max": 1 },
        "accent-color": { "type": "color", "min": 0, "max": 1 },

        "surface-background": { "type": "color", "min": 0, "max": 1 },
        "surface-text": { "type": "color", "min": 0, "max": 1 },
        "surface-border": { "type": "color", "min": 0, "max": 1 },

        "header-background": { "type": "color", "min": 0, "max": 1 },
        "header-label": { "type": "color", "min": 0, "max": 1 },
        "header-title": { "type": "color", "min": 0, "max": 1 },
        "header-description": { "type": "color", "min": 0, "max": 1 },
        "header-border": { "type": "color", "min": 0, "max": 1 },
        "budget-background": { "type": "color", "min": 0, "max": 1 },
        "budget-label": { "type": "color", "min": 0, "max": 1 },
        "budget-value": { "type": "color", "min": 0, "max": 1 },
        "budget-border": { "type": "color", "min": 0, "max": 1 },

        "section-gutter": { "type": "color", "min": 0, "max": 1 },
        "section-background": { "type": "color", "min": 0, "max": 1 },
        "section-heading": { "type": "color", "min": 0, "max": 1 },
        "section-body": { "type": "color", "min": 0, "max": 1 },
        "section-border": { "type": "color", "min": 0, "max": 1 },

        "choice-background": { "type": "color", "min": 0, "max": 1 },
        "choice-heading": { "type": "color", "min": 0, "max": 1 },
        "choice-body": { "type": "color", "min": 0, "max": 1 },
        "choice-border": { "type": "color", "min": 0, "max": 1 },
        "group-background": { "type": "color", "min": 0, "max": 1 },
        "group-footer-background": { "type": "color", "min": 0, "max": 1 },
        "group-text": { "type": "color", "min": 0, "max": 1 },
        "group-border": { "type": "color", "min": 0, "max": 1 },

        "control-background": { "type": "color", "min": 0, "max": 1 },
        "control-text": { "type": "color", "min": 0, "max": 1 },
        "control-muted-text": { "type": "color", "min": 0, "max": 1 },
        "control-border": { "type": "color", "min": 0, "max": 1 },
        "control-indicator": { "type": "color", "min": 0, "max": 1 },
        "control-accent": { "type": "color", "min": 0, "max": 1 },
        "control-hover-background": { "type": "color", "min": 0, "max": 1 },
        "control-hover-text": { "type": "color", "min": 0, "max": 1 },
        "control-hover-border": { "type": "color", "min": 0, "max": 1 },
        "control-pressed-background": { "type": "color", "min": 0, "max": 1 },
        "control-pressed-text": { "type": "color", "min": 0, "max": 1 },
        "control-pressed-border": { "type": "color", "min": 0, "max": 1 },
        "control-selected-background": { "type": "color", "min": 0, "max": 1 },
        "control-selected-text": { "type": "color", "min": 0, "max": 1 },
        "control-selected-border": { "type": "color", "min": 0, "max": 1 },
        "control-disabled-background": { "type": "color", "min": 0, "max": 1 },
        "control-disabled-text": { "type": "color", "min": 0, "max": 1 },
        "control-disabled-border": { "type": "color", "min": 0, "max": 1 },
        "control-disabled-indicator": { "type": "color", "min": 0, "max": 1 },

        "cost-background": { "type": "color", "min": 0, "max": 1 },
        "cost-text": { "type": "color", "min": 0, "max": 1 },
        "cost-border": { "type": "color", "min": 0, "max": 1 },
        "cost-benefit-background": { "type": "color", "min": 0, "max": 1 },
        "cost-benefit-text": { "type": "color", "min": 0, "max": 1 },
        "cost-benefit-border": { "type": "color", "min": 0, "max": 1 },
        "cost-award-background": { "type": "color", "min": 0, "max": 1 },
        "cost-award-text": { "type": "color", "min": 0, "max": 1 },
        "cost-award-border": { "type": "color", "min": 0, "max": 1 },
        "cost-pending-background": { "type": "color", "min": 0, "max": 1 },
        "cost-pending-text": { "type": "color", "min": 0, "max": 1 },
        "cost-pending-border": { "type": "color", "min": 0, "max": 1 },

        "tooltip-background": { "type": "color", "min": 0, "max": 1 },
        "tooltip-text": { "type": "color", "min": 0, "max": 1 },
        "tooltip-border": { "type": "color", "min": 0, "max": 1 },

        "canvas-padding": { "type": "spacing", "min": 0, "max": 1 },
        "section-spacing": { "type": "spacing", "min": 0, "max": 1 },
        "section-padding": { "type": "spacing", "min": 0, "max": 1 },
        "corners": { "type": "enum", "values": ["none", "sm", "md", "lg", "pill"], "min": 0, "max": 1 },
        "control-corners": { "type": "enum", "values": ["none", "sm", "md", "lg", "pill"], "min": 0, "max": 1 },
        "cost-corners": { "type": "enum", "values": ["none", "sm", "md", "lg", "pill"], "min": 0, "max": 1 },
        "structural-border-width": { "type": "enum", "values": ["none", "thin", "medium", "thick"], "min": 0, "max": 1 }
      },
      "children": {}
    },
