  "semanticConstraints": [
    { "code": "section.choice.target", "rule": "a section-owned choice association requires a unique owner-local handle and a target resolving to one top-level choice" },
    { "code": "section.choice.unique_target", "rule": "one section may associate a top-level choice at most once" },
    { "code": "jump.grant.activation", "rule": "grants directly under jump are unconditional for the entry; property grants require explicit values because no owning control exists" },
    { "code": "choice-source.max", "rule": "max is an optional positive integer on multi sources, limits simultaneous selections without implying a minimum or default, and omission is unlimited" },
    { "code": "choice.discount", "rule": "active choices grant flat or percentage discounts to choice groups, optionally limited to repeated resource targets; jump policy controls stacking and the zero or negative floor" },
    { "code": "section.locking", "rule": "locked contributes its authored initial count from zero through five and omission also contributes zero; active lock and unlock effects contribute positive and negative one, and a positive total suspends editing and ordinary projections for choices placed only in that section" },
    { "code": "choice.continuity.domain", "rule": "continuity is valid only on selection select with exactly one direct property grant to gender whose value is omitted" },
    { "code": "choice.integer.bounds", "rule": "integer min must not exceed max; random/either requires both finite bounds" },
    { "code": "choice.select.options", "rule": "option is valid only for selection select; empty option values warn and are omitted; zero non-empty options is a warning" },
    { "code": "choice.resolution.domain", "rule": "choice resolution is valid only for integer or select" },
    { "code": "cost.unique_resource", "rule": "a choice has at most one cost per resolved resource" },
    { "code": "cost.each.integer_only", "rule": "mode each requires selection integer and explicit min >= 0" },
    { "code": "choice.companions.bounds", "rule": "selection companions defaults min and max to 1, requires explicit bounds to be positive, and min must not exceed max" },
    { "code": "choice.companions.funding", "rule": "every companion-selection choice handle requires at least one positive targeted resource grant so imported companions can participate" },
    { "code": "choice.companions.shorthand", "rule": "a companion-selection choice cannot use scalar companion shorthand because both would claim the owning choice handle" },
    { "code": "choice.placeholder.domain", "rule": "choice placeholder is invalid for toggle because no empty field is rendered" },
    { "code": "input.bounds", "rule": "min/max are valid only for integer inputs" },
    { "code": "input.options", "rule": "option is valid only for selection select; empty option values warn and are omitted; zero non-empty options is a warning" },
    { "code": "grant.resource.fields", "rule": "kind resource requires resource and amount and permits neither to be omitted" },
    { "code": "grant.property.fields", "rule": "kind property requires handle; omitted value copies the owning control" },
    { "code": "grant.property.reserved_types", "rule": "origin, species, location, and gender resolve to strings; age resolves to an integer; copied origin, species, and location require compatible string controls; copied gender requires a select choice and copied age requires an integer choice" },
    { "code": "grant.property.entry_scope", "rule": "property grants apply only in their owning chain entry; only engine identity continuity may seed gender and age from earlier entries" },
    { "code": "grant.form.handle", "rule": "kind form requires a unique package-wide stable handle" },
    { "code": "grant.form.reference", "rule": "form on a perk grant resolves a package-wide form handle across sections, files, and forward references" },
    { "code": "grant.form.target_kind", "rule": "form ownership is valid only on perk grants; other grant kinds cannot target a form" },
    { "code": "grant.form.shorthand", "rule": "choice-level form requires exactly one scalar perk grant and targets only that grant" },
    { "code": "grant.companion.handle", "rule": "block kind companion requires a unique package-wide stable handle; scalar companion shorthand uses its owning choice handle" },
    { "code": "grant.companion.reference", "rule": "companion on a perk or resource grant resolves either a companion grant handle or a companion-selection choice handle across sections, files, and forward references" },
    { "code": "grant.companion.target_kind", "rule": "companion ownership is valid only on perk and resource grants" },
    { "code": "grant.companion.shorthand", "rule": "choice-level companion requires exactly one scalar perk grant and targets only that grant" },
    { "code": "grant.owner.conflict", "rule": "one grant cannot target both form and companion owners" },
    { "code": "grant.measure.integer_only", "rule": "measure is valid only for a visible grant owned by an integer choice or input; omission defaults such grants to rank" },
    { "code": "grant.measure.shorthand", "rule": "choice-level measure requires exactly one scalar perk or item grant and targets only that grant" },
    { "code": "grant.visible.fields", "rule": "name and tag are valid only for perk, item, form, companion, and trait; ordinary visible grants accept one owner-local text handle named description; trait grants may additionally expose owner-local text and image content through a trait layout; layout is valid only for trait; form is valid only on perk; companion is valid only on perk and resource; measure is valid only on perk, item, and trait" },
    { "code": "layout.typed_target", "rule": "typed leaves and background-image presentation resolve only in the matching owner-local namespace; absent targets warn; leaves collapse while a missing background omits only its image layer" },
    { "code": "layout.choice.target", "rule": "a compact choice leaf resolves one choice-placement owned by the rendered section and each placement may appear at most once" },
    { "code": "layout.rule.orientation", "rule": "rules are horizontal by default; vertical rules stretch through the shared block extent of an inline row" },
    { "code": "layout.expand.source", "rule": "expand source resolves in the rendered section and each source may be expanded at most once" },
    { "code": "package.asset_path", "rule": "authored asset paths are relative to the implicit assets root, use portable forward slashes, remain within that root, and resolve to supported graphical files" }
  ]
