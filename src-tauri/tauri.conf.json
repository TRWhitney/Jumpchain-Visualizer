{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jumpchain Visualizer",
  "version": "0.1.0",
  "identifier": "dev.jumpchainvisualizer.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Jumpchain Visualizer",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self'; font-src 'self'; worker-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Whitney White",
    "homepage": "https://github.com/TRWhitney/Jumpchain-Visualizer",
    "license": "Unlicense",
    "licenseFile": "../UNLICENSE.md",
    "category": "Productivity",
    "shortDescription": "Offline-first Jumpchain editor and tracker.",
    "longDescription": "Create, inspect, visualize, and track Jumpchain packages and chains entirely on your local device.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../UNLICENSE.md": "UNLICENSE.md",
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    }
  }
}
