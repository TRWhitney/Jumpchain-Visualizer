choice
  handle: engine_tier
  name: "Engine Tier"
  name when tier >= 4: "Engine Tier · Transcendent"
  group: calibration_controls
  selection: integer
  min: 0
  max: 5
  cost: 0

  grant
    kind: property
    handle: tier

choice
  handle: engine_path
  name: "Engine Path"
  group: calibration_controls
  selection: select
  option: "Foundation"
  option when tier >= 3: "Foundation Prime"
  option: "Synthesis"
  option when engine_enabled and tier > 0: "Living Synthesis"
  option: "Horizon"
  cost: 0

  grant
    kind: property
    handle: engine_path

choice
  handle: engine_enabled
  name: "Activate the Engine"
  group: calibration_controls
  selection: toggle
  cost: 0

  grant
    kind: property
    handle: engine_enabled
    value: true

choice
  handle: confluence_gender
  name: "Confluence Gender"
  group: calibration_controls
  selection: select
  continuity: original
  option: "Female"
  option: "Male"
  option: "Nonbinary"
  cost: 100

  grant
    kind: property
    handle: gender

choice
  handle: debt_offset
  name: "Paradox Ground"
  group: scales
  tag: meta
  tag: crafting
  cost: 0

  grant
    kind: resource
    resource: paradox
    amount: 2

  grant: perk

