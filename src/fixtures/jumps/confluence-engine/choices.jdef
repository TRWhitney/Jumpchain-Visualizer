  handle: award_trivial
  name: "Trivial Service"
  group: scales
  cost: add_trivial
  grant: perk

choice
  handle: award_small
  name: "Small Service"
  group: scales
  cost: add_small
  grant: perk

choice
  handle: award_medium
  name: "Medium Service"
  group: scales
  cost: add_medium
  grant: perk

