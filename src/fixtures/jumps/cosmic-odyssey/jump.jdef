jump
  format: 1
  name: "Cosmic Odyssey"
  author: "Jumpchain Visualizer"
  version: "2.3"
  gauntlet: true

resource
  handle: salvage
  name: "Salvage"
  initial: 3

section
  handle: expedition
  name: "Expedition Assignment"

  choice-source
    handle: assignment
    group: assignments
    mode: single
    resolution: random

section
  handle: systems
  name: "Ship Systems"

  choice-source
    handle: systems
    group: systems
    mode: multi
    resolution: random

section
  handle: calibration
  name: "Calibration"

  choice
    handle: age_roll
    target: starting_age

  choice
    handle: training_roll
    target: random_training

choice
  handle: explorer
  name: "Explorer"
  group: assignments
  tag: technology
  cost: 100

  grant
    kind: property
    handle: origin
    value: "Explorer"

  grant
    kind: property
    handle: location
    value: "Orbital Survey"

choice
  handle: envoy
  name: "Envoy"
  group: assignments
  tag: social
  cost: 200

  grant
    kind: property
    handle: origin
    value: "Envoy"

choice
  handle: stellar_intuition
  name: "Stellar Intuition"
  group: systems
  tag: technology
  tag: meta
  cost: 200
  grant: perk

  grant
    kind: perk
    name: "Vacuum Adaptation"
    tag: physical
    tag: summoning

  grant
    kind: perk
    name: "Xeno Navigation"
    tag: mental
    tag: necromancy

  grant
    kind: perk
    name: "Signal Concealment"
    tag: stealth
    tag: illusion

  grant
    kind: companion
    name: "Io"
    tag: technology
    tag: pilot

choice
  handle: survey_skiff
  name: "Survey Skiff"
  group: systems
  tag: technology
  tag: vehicles
  cost: 100

  cost
    resource: salvage
    amount: 2

  grant: item

  grant
    kind: item
    name: "Survey Drones"
    tag: technology

  grant
    kind: perk
    name: "Emergency Engineering"
    tag: crafting

  grant
    kind: perk
    name: "Hull Discipline"
    tag: defense

choice
  handle: starting_age
  name: "Starting Age"
  selection: integer
  min: 18
  max: 72
  resolution: random
  cost: 200

  grant
    kind: property
    handle: age

choice
  handle: random_training
  name: "Random Training"
  selection: integer
  min: 0
  max: 5
  resolution: random

  cost
    resource: jump_points
    amount: 50
    mode: each

  grant: perk
