jump
  format: 1
  name: "The Dream Archive"
  author: "Jumpchain Visualizer"
  version: "2.0"
  section-layout: archive_layout

resource
  handle: lucidity
  name: "Lucidity"
  abbreviation: "LU"
  initial: 2

section
  handle: archive
  name: "Dream Index"
  layout: archive_layout

  text
    handle: introduction
    content:
      """
      Shelve **remembered worlds**, mark *uncertain paths*, and keep ++lucid anchors++ close.

      - Index a recurring dream
      - Preserve a waking memory
      """
    content when gauntlet: "The archive is sealed during this Gauntlet, but its index remains readable."

  image
    handle: archive_mark
    src: "assets/dream-archive-mark.svg"
    alt: "A geometric moon above an open archive"

  choice-source
    handle: main
    group: archive

choice
  handle: dream_indexing
  name: "Dream Indexing"
  group: archive
  tag: mental
  cost: 200
  grant: perk

choice
  handle: mnemonic_shelf
  name: "Mnemonic Shelf"
  group: archive
  tag: miscellaneous
  cost: 100
  grant: item

choice
  handle: lucid_reserve
  name: "Lucid Reserve"
  group: archive
  tag: spiritual
  cost: 0

  grant
    kind: resource
    resource: lucidity
    amount: 3

  grant: perk

section-layout
  handle: archive_layout

  stack
    handle: root
    gap: md

    wrap
      handle: archive_heading
      gap: md
      align: center
      slot: name
      image: archive_mark

    rule
    text: introduction

    expand
      source: main
