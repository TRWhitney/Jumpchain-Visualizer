jump
  format: 1
  name: "First Step"
  author: "Jumpchain Visualizer"
  version: "1.0"
  section-layout: section_stack
  choice-layout: choice_card

section
  handle: introduction
  name: "Introduction"
  layout: introduction_section

  text
    handle: description
    content:
      """
      Begin a chain with dependable foundations, a clear identity, and a few practical advantages.
      """

section
  handle: identity
  name: "Identity"
  layout: identity_section

  choice
    handle: gender_field
    target: starting_gender

  choice
    handle: age_field
    target: starting_age

section
  handle: origins
  name: "Origins"

  choice-source
    handle: main
    group: origins
    mode: single

section
  handle: perks
  name: "Perks"

  choice-source
    handle: main
    group: perks
    mode: multi

section
  handle: companions
  name: "Companions"

  choice-source
    handle: main
    group: companions
    mode: multi

choice
  handle: starting_gender
  name: "Gender"
  selection: select
  option: "Male"
  option: "Female"

  grant
    kind: property
    handle: gender

choice
  handle: starting_age
  name: "Age"
  selection: integer
  min: 1

  grant
    kind: property
    handle: age

choice
  handle: wanderer
  name: "Wanderer"
  group: origins
  tag: social
  cost: 0

  text
    handle: description
    content: "You arrive without local ties or obligations."

  grant
    kind: property
    handle: origin
    value: "Wanderer"

  grant
    kind: property
    handle: location
    value: "Crossroads"

choice
  handle: local_hero
  name: "Local Hero"
  group: origins
  tag: combat
  cost: 100

  text
    handle: description
    content: "Your first world already knows your name and your better deeds."

  grant
    kind: property
    handle: origin
    value: "Local Hero"

  grant
    kind: property
    handle: location
    value: "Home District"

choice
  handle: adaptable_baseline
  name: "Adaptable Baseline"
  group: perks
  tag: physical
  tag: adaptation
  cost: 100

  text
    handle: description
    content: "Your body adjusts quickly to unfamiliar environments."

  grant: perk

  grant
    kind: perk
    name: "Traveler's Instinct"
    tag: stealth

  grant
    kind: perk
    name: "Quick Study"
    tag: mental
    tag: learning

  grant
    kind: perk
    name: "Steady Nerves"
    tag: defense

choice
  handle: travelers_pack
  name: "Traveler's Pack"
  group: perks
  tag: miscellaneous
  tag: convenience
  cost: 100
  grant: item

  grant
    kind: item
    name: "Portable Shelter"
    tag: crafting

  grant
    kind: perk
    name: "Friendly Introduction"
    tag: social

  grant
    kind: perk
    name: "First Spark"
    tag: magic

choice
  handle: ash_companion
  name: "Ash"
  group: companions
  tag: social
  tag: support
  cost: 200

  text
    handle: description
    content: "A reliable traveler and support specialist joins the chain."

  grant: companion

section-layout
  handle: introduction_section

  stack
    handle: root
    gap: md
    slot: name
    text: description

section-layout
  handle: identity_section

  stack
    handle: root
    gap: md
    slot: name

    grid
      handle: identity_grid
      columns: 2
      gap: md
      choice: gender_field
      choice: age_field

section-layout
  handle: section_stack

  stack
    handle: root
    gap: md
    slot: name

    expand
      source: main
      using: choice_card

choice-layout
  handle: choice_card

  stack
    handle: root
    gap: sm

    inline
      handle: heading
      justify: between
      slot: name
      slot: cost

    text: description
    slot: tags
    slot: control
    slot: roll
