jump
  format: 1
  name: "Hero Academy"
  author: "Jumpchain Visualizer"
  version: "1.0"

resource
  handle: merit
  name: "Academy Merit"
  abbreviation: "Merit"
  initial: 5

section
  handle: controls
  name: "Enrollment Controls"
  layout: control_grid

  choice
    handle: night_vision_field
    target: night_vision

  choice
    handle: alias_field
    target: hero_alias

  choice
    handle: lives_field
    target: extra_lives

  choice
    handle: training_field
    target: combat_training

  choice
    handle: age_field
    target: random_age

  choice
    handle: random_training_field
    target: random_training

  choice
    handle: power_field
    target: power_rank

  choice
    handle: techniques_field
    target: technique_ranks

  choice
    handle: region_field
    target: starting_region

  choice
    handle: destiny_field
    target: destiny

  choice
    handle: element_field
    target: element

  choice
    handle: stipend_field
    target: danger_stipend

  choice
    handle: requisition_field
    target: academy_requisition

section
  handle: single_manual
  name: "Manual Assignment"

  choice-source
    handle: assignment
    group: single_manual
    mode: single

section
  handle: single_random
  name: "Random Assignment"

  choice-source
    handle: assignment
    group: single_random
    mode: single
    resolution: random

section
  handle: single_either
  name: "Chosen or Random Assignment"

  choice-source
    handle: assignment
    group: single_either
    mode: single
    resolution: either

section
  handle: multi_manual
  name: "Manual Electives"

  choice-source
    handle: electives
    group: multi_manual
    mode: multi

section
  handle: multi_random
  name: "Random Electives"

  choice-source
    handle: electives
    group: multi_random
    mode: multi
    resolution: random

section
  handle: multi_either
  name: "Chosen or Random Electives"

  choice-source
    handle: electives
    group: multi_either
    mode: multi
    resolution: either

choice
  handle: night_vision
  name: "Night Vision"
  tag: perception
  cost: 100
  grant: perk

choice
  handle: hero_alias
  name: "Alias"
  selection: text
  tag: identity
  cost: 0
  grant: perk

choice
  handle: extra_lives
  name: "Extra Lives"
  selection: integer
  min: 0
  max: 5
  tag: meta
  cost: 200
  grant: perk

choice
  handle: combat_training
  name: "Combat Training"
  selection: integer
  min: 0
  max: 5
  tag: combat

  cost
    resource: jump_points
    amount: 50
    mode: each

  grant: perk

choice
  handle: random_age
  name: "Starting Age"
  selection: integer
  min: 18
  max: 42
  resolution: random
  tag: identity
  cost: 200

  grant
    kind: property
    handle: age

choice
  handle: random_training
  name: "Random Training"
  selection: integer
  min: 1
  max: 5
  resolution: random
  tag: training

  cost
    resource: jump_points
    amount: 50
    mode: each

  grant: perk

choice
  handle: power_rank
  name: "Power Rank"
  selection: integer
  min: 1
  max: 5
  resolution: either
  tag: magic
  cost: 300
  grant: perk

choice
  handle: technique_ranks
  name: "Technique Ranks"
  selection: integer
  min: 0
  max: 5
  resolution: either
  tag: combat

  cost
    resource: jump_points
    amount: 50
    mode: each

  grant: perk

choice
  handle: starting_region
  name: "Starting Region"
  selection: select
  option: "North"
  option: "Capital"
  option: "Coast"
  tag: location
  cost: 100

  grant
    kind: property
    handle: location

choice
  handle: destiny
  name: "Destiny"
  selection: select
  resolution: random
  option: "Hero"
  option: "Sage"
  option: "Wanderer"
  tag: spiritual
  cost: 100
  grant: perk

choice
  handle: element
  name: "Element"
  selection: select
  resolution: either
  option: "Fire"
  option: "Water"
  option: "Wind"
  tag: magic
  cost: 200
  grant: perk

choice
  handle: danger_stipend
  name: "Danger Stipend"
  selection: select
  resolution: either
  option: "Accept"
  option: "Decline"
  tag: challenge
  cost: -100

choice
  handle: academy_requisition
  name: "Academy Requisition"
  selection: select
  resolution: either
  option: "Field Kit"
  option: "Laboratory Kit"
  tag: equipment

  cost
    resource: jump_points
    amount: 100

  cost
    resource: merit
    amount: 2

  grant: item

choice
  handle: manual_scholar
  name: "Scholar"
  group: single_manual
  cost: 100
  grant: perk

choice
  handle: manual_wanderer
  name: "Wanderer"
  group: single_manual
  cost: 200
  grant: perk

choice
  handle: random_scholar
  name: "Scholar"
  group: single_random
  cost: 100
  grant: perk

choice
  handle: random_wanderer
  name: "Wanderer"
  group: single_random
  cost: 200
  grant: perk

choice
  handle: either_scholar
  name: "Scholar"
  group: single_either
  cost: 100
  grant: perk

choice
  handle: either_wanderer
  name: "Wanderer"
  group: single_either
  cost: 200
  grant: perk

choice
  handle: manual_flight
  name: "Flight"
  group: multi_manual
  cost: 100
  grant: perk

choice
  handle: manual_arcane
  name: "Arcane Study"
  group: multi_manual
  cost: 200
  grant: perk

choice
  handle: random_flight
  name: "Flight"
  group: multi_random
  cost: 100
  grant: perk

choice
  handle: random_arcane
  name: "Arcane Study"
  group: multi_random
  cost: 200
  grant: perk

choice
  handle: either_flight
  name: "Flight"
  group: multi_either
  cost: 100
  grant: perk

choice
  handle: either_arcane
  name: "Arcane Study"
  group: multi_either
  cost: 200
  grant: perk

section-layout
  handle: control_grid

  grid
    handle: root
    columns: 2
    gap: md
    choice: night_vision_field
    choice: alias_field
    choice: lives_field
    choice: training_field
    choice: age_field
    choice: random_training_field
    choice: power_field
    choice: techniques_field
    choice: region_field
    choice: destiny_field
    choice: element_field
    choice: stipend_field
    choice: requisition_field
